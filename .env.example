# Copy to .env for local runs. Every key is optional; `python -m outreach doctor` shows what's active.

# Safety — keep true until you've reviewed state/outbox.md
DRY_RUN=true
OUTREACH_MODE=internship          # internship | job

# LLM (one needed for drafting). Chains: Anthropic → Groq → Gemini free-tier Flash models (see outreach/llm.py)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=                   # free tier; comma-separate keys from several projects to multiply the 20/day/model quota
# LLM_PROVIDER=auto  LLM_FAST_MODEL=  LLM_WRITER_MODEL=

# Web search (DuckDuckGo is the free fallback; Serper/Tavily also enable automatic discovery)
SERPER_API_KEY=
TAVILY_API_KEY=

# Email finders (waterfall order: Hunter → Findymail → Prospeo → LeadMagic → AnymailFinder → Apollo)
HUNTER_API_KEY=
FINDYMAIL_API_KEY=
PROSPEO_API_KEY=
LEADMAGIC_API_KEY=
ANYMAILFINDER_KEY=
APOLLO_API_KEY=                   # free plan API needs a work-email-registered Apollo account
APOLLO_MATCH_BUDGET=10

# Email verifiers (needed to confirm pattern-guessed addresses; SMTP probing is blocked on GitHub runners)
MILLIONVERIFIER_API_KEY=
ZEROBOUNCE_API_KEY=
REOON_API_KEY=
BOUNCER_API_KEY=

# Gmail (App Password: myaccount.google.com → Security → App passwords). Also used for IMAP reply detection.
SENDER_EMAIL=
GMAIL_APP_PASSWORD=

# Volumes & thresholds
WEEKLY_TARGET=80
DAILY_SEND_CAP=16
WEEKLY_CAP=70
MAX_PER_RUN=8
CATCH_ALL_MIN_CONFIDENCE=70
ATTACH_RESUME=false
